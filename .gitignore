# =============================================================================
# Xcode
# =============================================================================
# Build artifacts
build/
DerivedData/

# Generated by XcodeGen — project.yml が source of truth。
# .xcodeproj はコミットしない(誰かが clone したら `xcodegen generate` する運用)。
*.xcodeproj/
*.xcworkspace/
!project.yml

# Per-user Xcode 状態(他人と共有不要)
xcuserdata/
*.xcuserstate
*.xcuserdatad/
*.moved-aside

# Index, dSYM, header maps
*.hmap
*.dSYM
*.dSYM.zip

# Playgrounds
timeline.xctimeline
playground.xcworkspace

# =============================================================================
# Swift Package Manager
# =============================================================================
.swiftpm/
.build/
Package.resolved

# =============================================================================
# 依存管理(将来使う可能性のあるものを念のため)
# =============================================================================
# CocoaPods
Pods/
Podfile.lock

# Carthage
Carthage/Build/
Carthage/Checkouts/

# =============================================================================
# 開発ツール / IDE
# =============================================================================
# JetBrains (AppCode 等)
.idea/
*.iml

# VS Code
.vscode/

# Vim
*.swp
*.swo
*~

# SwiftLint cache
.swiftlint/

# =============================================================================
# 配布関連 / 機密
# =============================================================================
# Provisioning profiles / certificates(誤コミット防止)
*.mobileprovision
*.provisionprofile
*.p12
*.cer
*.certSigningRequest

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output/

# =============================================================================
# ログ・実行時データ
# =============================================================================
*.log

# 本アプリ自身が生成するユーザー設定ファイル
# (~/Library/Application Support/MyActionHub/config.json には書くが、
#  万が一プロジェクト内に config.json が落ちても掴まないように一応除外)
config.json
*.broken-*
